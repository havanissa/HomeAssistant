{
 "name": "bed_occupancy",
 "description": "A bed sensor (Maintain) holds a bedroom all night; presence stuck detection is off by default.",
 "rooms": {
  "bedroom": {
   "sensors": [
    {
     "entity_id": "binary_sensor.pir",
     "kind": "pir",
     "role": "trigger"
    },
    {
     "entity_id": "binary_sensor.bed",
     "kind": "bed",
     "role": "maintain"
    }
   ]
  }
 },
 "initial": {
  "binary_sensor.pir": "off",
  "binary_sensor.bed": "off"
 },
 "events": [
  {
   "t": 0,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 20,
   "entity": "binary_sensor.bed",
   "state": "on"
  },
  {
   "t": 30,
   "entity": "binary_sensor.pir",
   "state": "off"
  },
  {
   "t": 28800,
   "entity": "binary_sensor.bed",
   "state": "off"
  },
  {
   "t": 28810,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 28840,
   "entity": "binary_sensor.pir",
   "state": "off"
  }
 ],
 "until": 30000,
 "expect": [
  {
   "t": 0.0,
   "area": "bedroom",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacant",
   "start": true
  },
  {
   "t": 0.0,
   "area": "bedroom",
   "state": "possible_occupancy",
   "occupied": true,
   "reason_code": "possible_occupancy"
  },
  {
   "t": 10.0,
   "area": "bedroom",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 28840.0,
   "area": "bedroom",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 29440.0,
   "area": "bedroom",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacated"
  }
 ]
}
