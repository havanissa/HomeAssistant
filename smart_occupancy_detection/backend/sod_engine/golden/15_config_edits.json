{
 "name": "config_edits",
 "description": "Live configuration edits during occupancy: excluding the holding signal, a role change to Confirm vacancy and shorter timing.",
 "rooms": {
  "kamar": {
   "sensors": [
    {
     "entity_id": "binary_sensor.pir",
     "kind": "pir",
     "role": "trigger"
    },
    {
     "entity_id": "binary_sensor.radar",
     "kind": "radar",
     "role": "maintain"
    }
   ]
  }
 },
 "initial": {
  "binary_sensor.pir": "off",
  "binary_sensor.radar": "off"
 },
 "events": [
  {
   "t": 0,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 2,
   "entity": "binary_sensor.radar",
   "state": "on"
  },
  {
   "t": 60,
   "entity": "binary_sensor.pir",
   "state": "off"
  },
  {
   "t": 100,
   "reconfigure": {
    "kamar": {
     "sensors": [
      {
       "entity_id": "binary_sensor.pir",
       "kind": "pir",
       "role": "trigger"
      },
      {
       "entity_id": "binary_sensor.radar",
       "kind": "radar",
       "role": "maintain",
       "enabled": false
      }
     ]
    }
   }
  },
  {
   "t": 200,
   "reconfigure": {
    "kamar": {
     "sensors": [
      {
       "entity_id": "binary_sensor.pir",
       "kind": "pir",
       "role": "trigger"
      },
      {
       "entity_id": "binary_sensor.radar",
       "kind": "radar",
       "role": "confirm_vacancy"
      }
     ],
     "timing": {
      "exit_confirmation": 120
     }
    }
   }
  },
  {
   "t": 400,
   "entity": "binary_sensor.radar",
   "state": "off"
  }
 ],
 "until": 1500,
 "expect": [
  {
   "t": 0.0,
   "area": "kamar",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacant",
   "start": true
  },
  {
   "t": 0.0,
   "area": "kamar",
   "state": "possible_occupancy",
   "occupied": true,
   "reason_code": "possible_occupancy"
  },
  {
   "t": 2.0,
   "area": "kamar",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 100.0,
   "area": "kamar",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 200.0,
   "area": "kamar",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 430.0,
   "area": "kamar",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 520.0,
   "area": "kamar",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacated"
  }
 ]
}
