{
 "name": "all_unavailable",
 "description": "Every occupancy sensor unavailable: uncertain, the last occupied value is kept; on recovery the quiet period starts again.",
 "rooms": {
  "kitchen": {
   "sensors": [
    {
     "entity_id": "binary_sensor.pir",
     "kind": "pir",
     "role": "trigger"
    },
    {
     "entity_id": "binary_sensor.radar",
     "kind": "radar",
     "role": "maintain"
    }
   ]
  }
 },
 "initial": {
  "binary_sensor.pir": "off",
  "binary_sensor.radar": "off"
 },
 "events": [
  {
   "t": 0,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 1,
   "entity": "binary_sensor.radar",
   "state": "on"
  },
  {
   "t": 30,
   "entity": "binary_sensor.pir",
   "state": "off"
  },
  {
   "t": 60,
   "entity": "binary_sensor.radar",
   "state": "off"
  },
  {
   "t": 100,
   "entity": "binary_sensor.pir",
   "state": "unavailable"
  },
  {
   "t": 100,
   "entity": "binary_sensor.radar",
   "state": "unavailable"
  },
  {
   "t": 5000,
   "entity": "binary_sensor.pir",
   "state": "off"
  },
  {
   "t": 5000,
   "entity": "binary_sensor.radar",
   "state": "off"
  }
 ],
 "until": 6000,
 "expect": [
  {
   "t": 0.0,
   "area": "kitchen",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacant",
   "start": true
  },
  {
   "t": 0.0,
   "area": "kitchen",
   "state": "possible_occupancy",
   "occupied": true,
   "reason_code": "possible_occupancy"
  },
  {
   "t": 1.0,
   "area": "kitchen",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 90.0,
   "area": "kitchen",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 100.0,
   "area": "kitchen",
   "state": "uncertain",
   "occupied": true,
   "reason_code": "all_signals_unknown"
  },
  {
   "t": 5000.0,
   "area": "kitchen",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 5600.0,
   "area": "kitchen",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacated"
  }
 ]
}
