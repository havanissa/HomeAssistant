{
 "name": "long_inactivity",
 "description": "A four-hour inactivity timeout and quiet periods of hours.",
 "rooms": {
  "cellar": {
   "sensors": [
    {
     "entity_id": "binary_sensor.pir",
     "kind": "pir",
     "role": "trigger"
    },
    {
     "entity_id": "binary_sensor.radar",
     "kind": "radar",
     "role": "maintain"
    }
   ],
   "timing": {
    "inactivity_timeout": 14400,
    "exit_confirmation": 1800
   }
  }
 },
 "initial": {
  "binary_sensor.pir": "off",
  "binary_sensor.radar": "off"
 },
 "events": [
  {
   "t": 0,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 5,
   "entity": "binary_sensor.radar",
   "state": "on"
  },
  {
   "t": 65,
   "entity": "binary_sensor.pir",
   "state": "off"
  },
  {
   "t": 3600,
   "entity": "binary_sensor.radar",
   "state": "off"
  },
  {
   "t": 10000,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 10030,
   "entity": "binary_sensor.pir",
   "state": "off"
  }
 ],
 "until": 40000,
 "expect": [
  {
   "t": 0.0,
   "area": "cellar",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacant",
   "start": true
  },
  {
   "t": 0.0,
   "area": "cellar",
   "state": "possible_occupancy",
   "occupied": true,
   "reason_code": "possible_occupancy"
  },
  {
   "t": 5.0,
   "area": "cellar",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 3630.0,
   "area": "cellar",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 10000.0,
   "area": "cellar",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 10030.0,
   "area": "cellar",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 24430.0,
   "area": "cellar",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacated"
  }
 ]
}
