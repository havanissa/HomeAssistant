{
 "name": "confirm_vacancy_role",
 "description": "A Confirm-vacancy radar that cleared is positive vacancy evidence: the fast exit path.",
 "rooms": {
  "bath": {
   "sensors": [
    {
     "entity_id": "binary_sensor.pir",
     "kind": "pir",
     "role": "trigger"
    },
    {
     "entity_id": "binary_sensor.radar",
     "kind": "radar",
     "role": "confirm_vacancy"
    }
   ]
  }
 },
 "initial": {
  "binary_sensor.pir": "off",
  "binary_sensor.radar": "off"
 },
 "events": [
  {
   "t": 0,
   "entity": "binary_sensor.pir",
   "state": "on"
  },
  {
   "t": 3,
   "entity": "binary_sensor.radar",
   "state": "on"
  },
  {
   "t": 60,
   "entity": "binary_sensor.pir",
   "state": "off"
  },
  {
   "t": 400,
   "entity": "binary_sensor.radar",
   "state": "off"
  }
 ],
 "until": 1500,
 "expect": [
  {
   "t": 0.0,
   "area": "bath",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacant",
   "start": true
  },
  {
   "t": 0.0,
   "area": "bath",
   "state": "possible_occupancy",
   "occupied": true,
   "reason_code": "possible_occupancy"
  },
  {
   "t": 3.0,
   "area": "bath",
   "state": "confirmed_occupancy",
   "occupied": true,
   "reason_code": "occupied"
  },
  {
   "t": 430.0,
   "area": "bath",
   "state": "possible_vacancy",
   "occupied": true,
   "reason_code": "confirming_vacancy"
  },
  {
   "t": 700.0,
   "area": "bath",
   "state": "vacant",
   "occupied": false,
   "reason_code": "vacated"
  }
 ]
}
