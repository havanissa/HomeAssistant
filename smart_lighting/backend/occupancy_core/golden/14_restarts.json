{
 "name": "restarts",
 "description": "Home Assistant restarts: an occupied room stays occupied (start-up hold, new quiet period), a vacancy countdown starts again, a vacant room stays vacant.",
 "rooms": {
  "kamar": {
   "sensors": [
    {
     "entity_id": "binary_sensor.pir",
     "kind": "pir",
     "role": "trigger"
    },
    {
     "entity_id": "binary_sensor.radar",
     "kind": "radar",
     "role": "maintain"
    }
   ],
   "timing": {
    "startup_hold": 120
   }
  },
  "stova": {
   "sensors": [
    {
     "entity_id": "binary_sensor.stova_pir",
     "kind": "pir",
     "role": "trigger"
    }
   ],
   "timing": {
    "startup_hold": 120
   }
  }
 },
 "initial": {
  "binary_sensor.pir": "off",
  "binary_sensor.radar": "off",
  "binary_sensor.stova_pir": "off"
 },
